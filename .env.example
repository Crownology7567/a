# Meta (Facebook) API Credentials
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Generate a User Access Token (or System User token) in
# Meta for Developers > Tools > Graph API Explorer
META_ACCESS_TOKEN=your_access_token_here

# From your Meta App dashboard
META_APP_ID=your_app_id_here
META_APP_SECRET=your_app_secret_here

# Your Ad Account ID — found in Ads Manager URL or Business Settings
# Must include the "act_" prefix, e.g. act_123456789
META_AD_ACCOUNT_ID=act_your_ad_account_id

# The Facebook Page ID linked to your ad account
META_PAGE_ID=your_page_id_here
